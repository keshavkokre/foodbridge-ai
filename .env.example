# Server Environment Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/foodbridge?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_64_character_string
CLIENT_ORIGIN=http://localhost:5173

# AI Model Configuration (Decoupled from IDE dev model)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Operational Parameters
IS_DEMO_INSTANCE=true
AUTO_EXPIRE_INTERVAL_MS=120000
RESPONSE_TTL_MINUTES=30
