# FoodBridge AI Environment Configuration Template
# Create your local .env file in the project root: Documents/foodbridge-ai/.env

# Server & Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas Database Connection (Replace with your Atlas connection URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/foodbridge_ai?retryWrites=true&w=majority

# JWT Authentication Secret (Use a secure random 64+ char string)
JWT_SECRET=your_secure_random_64_character_jwt_secret

# Google Gemini API Configuration (Runtime extraction & explainability)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Platform Administration Bootstrap Secret
ADMIN_BOOTSTRAP_SECRET=your_admin_bootstrap_secret

# Operational & Lifecycle Parameters
DEMO_MODE=false
IS_DEMO_INSTANCE=false
AUTO_EXPIRE_INTERVAL_MS=120000
RESPONSE_TTL_MINUTES=30
